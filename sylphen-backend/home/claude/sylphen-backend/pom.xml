<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================
         PARENT — Spring Boot 3 gestiona versiones automáticamente
         ===================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <!-- =====================================================
         IDENTIFICACIÓN DEL PROYECTO
         ===================================================== -->
    <groupId>com.sylphen</groupId>
    <artifactId>sylphen-backend</artifactId>
    <version>1.0.0</version>
    <name>sylphen-backend</name>
    <description>Sylphen — API REST de monitoreo energético</description>

    <!-- =====================================================
         JAVA 21
         ===================================================== -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- =====================================================
         DEPENDENCIAS
         ===================================================== -->
    <dependencies>

        <!-- Spring Web — habilita los controladores REST y el servidor Tomcat embebido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA — capa de persistencia, repositorios y entidades -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2 — base de datos en memoria para Fase 1 (sin necesidad de MySQL instalado) -->
        <!-- Cambiar a 'runtime' en Fase 2 cuando se active MySQL -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MySQL Connector — driver para Fase 2 (ya incluido, solo activar en properties) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok — elimina boilerplate: getters, setters, constructores, builders -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- BCrypt — para hashear contraseñas sin activar Spring Security completo -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Spring Boot Test — pruebas unitarias (incluye JUnit 5) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =====================================================
         BUILD — plugin de Spring Boot para mvn spring-boot:run
         ===================================================== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Excluir Lombok del JAR final (solo se necesita en compilación) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>